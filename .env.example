# Frontend → backend URL. RESTART `npm run dev` after editing (Next.js
# inlines NEXT_PUBLIC_* vars into the browser bundle at startup).
NEXT_PUBLIC_PARAKH_BACKEND=http://127.0.0.1:8000
NEXT_PUBLIC_PARAKH_API_URL=http://127.0.0.1:8000/api/v1

# Production (set these in Vercel -> Settings -> Environment Variables, then Redeploy).
# See deepfake-backend/DEPLOY.md:
# NEXT_PUBLIC_PARAKH_BACKEND=https://<hf-username>-parakh-backend.hf.space
# NEXT_PUBLIC_PARAKH_API_URL=https://<hf-username>-parakh-backend.hf.space/api/v1
