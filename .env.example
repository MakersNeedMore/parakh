# Frontend → backend URL. RESTART `npm run dev` after editing (Next.js
# inlines NEXT_PUBLIC_* vars into the browser bundle at startup).
NEXT_PUBLIC_PARAKH_BACKEND=http://127.0.0.1:8000
NEXT_PUBLIC_PARAKH_API_URL=http://127.0.0.1:8000/api/v1

# Production example (after deploying backend to Render / HF Spaces):
# NEXT_PUBLIC_PARAKH_BACKEND=https://parakh-inference.onrender.com
# NEXT_PUBLIC_PARAKH_API_URL=https://parakh-inference.onrender.com/api/v1
