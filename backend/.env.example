# Backend config. Backend reads this file automatically via python-dotenv
# IF you install python-dotenv, OR just export these in your shell.
# Simplest: edit values here, they are also respected as plain documentation
# because app.py falls back to safe defaults (HOST 127.0.0.1, PORT 8000).
HOST=127.0.0.1
PORT=8000
# Comma-separated list of frontend origins allowed to call the API.
# Local dev default covers Next.js on :3000. Add your Vercel URL in prod, e.g.:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://parakh.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
