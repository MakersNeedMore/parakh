# Copy this file to .env and replace SECRET_KEY before deployment.
APP_NAME=Parakh Deepfake Detection API
ENVIRONMENT=development
API_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=30
ALGORITHM=HS256
DATABASE_URL=sqlite:///./deepfake.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://anuragverma0907.github.io,https://parakh.xyz,https://pixpect.xyz
COOKIE_NAME=deepfake_access
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_IMAGE_MB=15
MAX_VIDEO_MB=100
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_SECONDS=180
MAX_VIDEO_SAMPLES=24
DEFAULT_VIDEO_SAMPLES=12
FAKE_THRESHOLD=0.5
DEEPFAKE_MODEL_ID=KoreaPeter/ms-eff-gcvit-deepfake-b0-ff-plus-plus
MODEL_DEVICE=auto
